{
  "name": "web3-ai-wallet",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @xone/web --filter @xone/wallet-api run dev",
    "dev:console": "pnpm -r --parallel --filter @xone/console --filter @xone/console-api run dev",
    "dev:admin": "pnpm -r --parallel --filter @xone/admin --filter @xone/admin-api run dev",
    "dev:docs": "pnpm --filter @xone/sdk-playground dev",
    "dev:site": "pnpm --filter @xone/marketing dev",
    "dev:web": "pnpm --filter @xone/web dev",
    "dev:api": "pnpm --filter @xone/wallet-api dev",
    "dev:admin-web": "pnpm --filter @xone/admin dev",
    "dev:admin-api": "pnpm --filter @xone/admin-api dev",
    "deploy": "pnpm run deploy:api && pnpm run deploy:web",
    "deploy:console": "pnpm run deploy:console-api && pnpm run deploy:console-web",
    "deploy:admin": "pnpm --filter @xone/admin run deploy",
    "deploy:docs": "pnpm --filter @xone/sdk-playground run deploy",
    "deploy:site": "pnpm --filter @xone/marketing run deploy",
    "deploy:api": "pnpm --filter @xone/wallet-api run deploy",
    "deploy:web": "pnpm --filter @xone/web run deploy",
    "deploy:admin-api": "pnpm --filter @xone/admin-api run deploy",
    "deploy:wallet-api": "pnpm --filter @xone/wallet-api run deploy",
    "deploy:console-web": "pnpm --filter @xone/console run deploy",
    "deploy:console-api": "pnpm --filter @xone/console-api run deploy",
    "deploy:ops": "pnpm run deploy:admin-api && pnpm run deploy:admin",
    "deploy:x402-seller": "pnpm --filter @xone/x402-seller run deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}