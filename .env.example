# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Privy (https://dashboard.privy.io)
VITE_PRIVY_APP_ID=

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=

# Custody / chain（可选备用）
CUSTODY_PRIVATE_KEY=
CUSTODY_ADDRESS=
RPC_URL=
JWT_SECRET=

# App
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: override default Base Sepolia RPC
# VITE_RPC_URL=
# Optional: Sepolia / Basescan history
VITE_ETHERSCAN_API_KEY=
# Local: http://localhost:4396
# Cloudflare: https://xone-wallet-api.<your-subdomain>.workers.dev
VITE_API_URL=http://localhost:4396
API_PORT=4396
# Local: http://localhost:5173
# Cloudflare Pages: https://xone-wallet-web.pages.dev
API_CORS_ORIGIN=http://localhost:5173
ALLOW_DEMO_AUTH=true
# Local Node API only: browser may use system proxy, but Node fetch does not.
# If workers.dev works in browser but /api/x402/merchant times out, set this
# to your local proxy (e.g. Clash 7897).
# HTTPS_PROXY=http://127.0.0.1:7897
