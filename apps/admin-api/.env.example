API_PORT=4397
API_CORS_ORIGIN=http://localhost:5174

# Console / XOne (keys, agents, console users)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Consumer wallet (profiles, legacy agents, payments, fundings)
WALLET_SUPABASE_URL=
WALLET_SUPABASE_ANON_KEY=
WALLET_SUPABASE_SERVICE_ROLE_KEY=

# Shared secret used to sign admin session JWTs
ADMIN_JWT_SECRET=change-me-admin-jwt-secret

# Comma-separated EVM wallets allowed to sign in (ops allowlist)
ADMIN_WALLETS=0xYourAdminWalletAddress
